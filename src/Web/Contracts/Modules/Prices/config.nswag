{
  "runtime": "Net100",
  "documentGenerator": {
    "fromDocument": {
      "url": "./api.yml"
    }
  },
  "codeGenerators": {
    "openApiToCSharpController": {
      "className": "IPricingController",
      "controllerStyle": "Abstract",
      "namespace": "VibraHeka.Web.Catalog.Pricing.Controllers",
      "generateController": true,
      "generateModelValidationAttributes": true,
      "generateDtoTypes": true,
      "useActionResultType": true,
      "templateDirectory" : "../../Templates",
      "output": "../../../Generated/PricingController.cs"
    }
  }
}